{
  "functions": {
    "api/send.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/app?p=index.html"
    },
    {
      "source": "/login",
      "destination": "/api/app?p=login.html"
    },
    {
      "source": "/tools/:file",
      "destination": "/api/app?p=tools/:file"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        }
      ]
    }
  ]
}
